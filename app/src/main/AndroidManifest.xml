<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <permission
        android:name="com.gravarty.launcher2.permission.INSTALL_SHORTCUT"
        android:protectionLevel="normal"
        android:label="@string/permlab_install_shortcut"
        android:description="@string/permdesc_install_shortcut" />
    <permission
        android:name="com.gravarty.launcher2.permission.UNINSTALL_SHORTCUT"
        android:protectionLevel="normal"
        android:label="@string/permlab_uninstall_shortcut"
        android:description="@string/permdesc_uninstall_shortcut"/>
    <permission
        android:name="com.gravarty.launcher2.permission.READ_SETTINGS"
        android:protectionLevel="normal"
        android:label="@string/permlab_read_settings"
        android:description="@string/permdesc_read_settings"/>
    <permission
        android:name="com.gravarty.launcher2.permission.WRITE_SETTINGS"
        android:protectionLevel="normal"
        android:label="@string/permlab_write_settings"
        android:description="@string/permdesc_write_settings"/>

    <!-- Modern Android: package visibility (API 30+). A home app has to see all launchable apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Port: the clock widget opens the alarms (ACTION_SHOW_ALARMS); some clock apps
         (e.g. Samsung's) require this permission for it -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Port: the weather widget of "News and Weather" (OpenWeatherMap) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Port: the YouTube widget's FeedJob needs a network (JobScheduler connectivity constraint) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Port: the "Power Control" widget from Settings -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="com.gravarty.launcher2.permission.READ_SETTINGS" />
    <uses-permission android:name="com.gravarty.launcher2.permission.WRITE_SETTINGS" />
    
    <application
        android:name="com.android.launcher2.LauncherApplication"
        android:label="@string/application_name"
        android:icon="@drawable/ic_launcher_home"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name="com.android.launcher2.Launcher"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="stateUnspecified|adjustPan"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY"/>
            </intent-filter>
        </activity>

        <!-- Tweaks: launcher settings -->
        <activity
            android:name="com.android.launcher2.Launcher$Settings"
            android:label="@string/group_tweaks"
            android:taskAffinity="com.gravarty.launcher2.settings"
            android:theme="@style/Theme.Settings"
            android:screenOrientation="nosensor"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name="com.android.launcher2.WallpaperChooser"
            android:label="@string/pick_wallpaper"
            android:icon="@drawable/ic_launcher_wallpaper"
            android:screenOrientation="nosensor"
            android:finishOnCloseSystemDialogs="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Intent received used to install shortcuts from other applications -->
        <receiver
            android:name="com.android.launcher2.InstallShortcutReceiver"
            android:exported="true"
            android:permission="com.gravarty.launcher2.permission.INSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <!-- Intent received used to uninstall shortcuts from other applications -->
        <receiver
            android:name="com.android.launcher2.UninstallShortcutReceiver"
            android:exported="true"
            android:permission="com.gravarty.launcher2.permission.UNINSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.UNINSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

        <!-- Modern Android (8.0+): apps pin shortcuts through ShortcutManager instead of the
             INSTALL_SHORTCUT broadcast. The default home app receives them here. -->
        <activity
            android:name="com.android.launcher2.PinShortcutActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Port: Gingerbread's search widget from AOSP QuickSearchBox, see
             SearchWidgetProvider. Placed by default like the original <search> favorite. -->
        <receiver android:name="com.android.quicksearchbox.SearchWidgetProvider"
            android:label="@string/search_widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>

        <!-- Port: Gingerbread's analog clock widget from AOSP DeskClock. -->
        <receiver android:name="com.android.alarmclock.AnalogAppWidgetProvider"
            android:label="@string/analog_gadget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/analog_appwidget" />
        </receiver>

        <!-- Port: the weather widget of Google's "News and Weather" 1.3.01 -->
        <receiver android:name="com.google.android.apps.genie.geniewidget.WeatherWidgetProvider"
            android:label="@string/genie_widget_weather" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/genie_weather_widget_info" />
        </receiver>

        <!-- Port: the widget of Google's "News and Weather" 1.3.01 with the weather on the left
             and the news on the right (RSS feeds of the launcher settings, loaded by NewsFeedJob) -->
        <receiver android:name="com.google.android.apps.genie.geniewidget.NewsWidgetProvider"
            android:label="@string/genie_news_widget_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
                <action android:name="com.android.launcher.genie.NEWS_RETRY" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/genie_news_widget_info" />
        </receiver>
        <service android:name="com.google.android.apps.genie.geniewidget.NewsFeedJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Port: the YouTube widget of YouTube 1.6.19, showing the newest videos of your
             subscriptions (RSS feeds of the channels, loaded by FeedJob) -->
        <receiver android:name="com.google.android.youtube.widget.WidgetProvider"
            android:label="@string/yt_widget_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
                <action android:name="com.google.android.youtube.REFRESH_TEASER_ACTION" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yt_widget_info" />
        </receiver>
        <service android:name="com.google.android.youtube.widget.FeedJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Port: the "Power Control" widget from AOSP Settings (android-2.3.7_r1).
             The state broadcasts are forwarded by LauncherApplication. -->
        <receiver android:name="com.android.settings.widget.SettingsAppWidgetProvider"
            android:label="@string/gadget_title" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/power_widget_info" />
        </receiver>

        <!-- Port: the "Nexus" live wallpaper from AOSP packages/wallpapers/Basic. -->
        <service
            android:label="@string/wallpaper_nexus"
            android:name="com.android.wallpaper.nexus.NexusWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/nexus" />
        </service>

        <!-- Port: the Nexus S variant of it (device/samsung/crespo overlay). -->
        <service
            android:label="@string/wallpaper_nexus_s"
            android:name="com.android.wallpaper.nexus.NexusSWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/nexus_s" />
        </service>

        <!-- The settings provider contains Home's data, like the workspace favorites -->
        <provider
            android:name="com.android.launcher2.LauncherProvider"
            android:exported="true"
            android:authorities="com.gravarty.launcher2.settings"
            android:writePermission="com.gravarty.launcher2.permission.WRITE_SETTINGS"
            android:readPermission="com.gravarty.launcher2.permission.READ_SETTINGS" />

        <!-- Tweaks: notification badges -->
        <service
            android:name="com.android.launcher2.BadgeListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
