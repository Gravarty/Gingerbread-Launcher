<?xml version="1.0" encoding="utf-8"?>
<!-- Port: values of Google's "News and Weather" 1.3.01 for the news widget (dimens, colors,
     integers of the miniwidget), plus the strings of the RSS feed settings -->
<resources>
    <dimen name="genie_news_weather_width">75dp</dimen>
    <!-- same distance to the widget edge as the weather icon has on the left: 4dp padding + (71dp - 45dp icon) / 2 -->
    <dimen name="genie_news_padding_right">17dp</dimen>
    <color name="genie_news_primary">#ffffffff</color>
    <color name="genie_news_secondary">#ffbebebe</color>
    <integer name="genie_news_interval">8000</integer>
    <integer name="genie_news_transition">400</integer>

    <string name="genie_news_widget_label">News and Weather</string>
    <string name="genie_news_category">News</string>
    <string name="genie_news_feeds">RSS feeds</string>
    <string name="genie_news_feeds_none">None configured</string>
    <plurals name="genie_news_feeds_count">
        <item quantity="one">%d feed</item>
        <item quantity="other">%d feeds</item>
    </plurals>
    <string name="genie_news_feeds_message">RSS or Atom feed URLs, one per line:</string>
    <string name="genie_news_feeds_invalid">No valid feed URLs found.</string>
    <string name="genie_news_hint">Tap to add news feeds in the launcher settings</string>
    <string name="genie_news_unavailable">News is currently unavailable.</string>
    <string name="genie_news_try_again">Unable to connect. Tap to try again.</string>
</resources>
