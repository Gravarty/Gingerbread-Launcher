<resources>
    <style name="Theme" parent="android:Theme.Wallpaper">
        <item name="android:windowNoTitle">true</item>
        <!-- Tweaks: no system scrim behind transparent bars (3-button navigation) -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
    </style>

    <!-- Port: settings of the weather widget (Gingerbread dark theme, own title bar) -->
    <style name="Theme.GenieConfigure" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Port: Gingerbread's system font, applied by Launcher.useDroidSans() -->
    <style name="DroidSansFont">
        <item name="android:fontFamily">@font/droid_sans</item>
    </style>

    <style name="AnimationPreview">
        <item name="android:windowEnterAnimation">@anim/fade_in_fast</item>
        <item name="android:windowExitAnimation">@anim/fade_out_fast</item>
    </style>
    
    <style name="WorkspaceIcon">
        <item name="android:textSize">13dip</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:shadowColor">#FF000000</item>
        <item name="android:shadowRadius">2.0</item>
        <item name="android:textColor">#FFF</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/shortcut_selector</item>
        <item name="android:paddingLeft">5dip</item>
        <item name="android:paddingRight">5dip</item>
    </style>

    <style name="WorkspaceIcon.Portrait">
        <item name="android:drawablePadding">5dip</item>
        <item name="android:paddingTop">4dip</item>
        <item name="android:layout_marginLeft">3dip</item>
        <item name="android:layout_marginRight">3dip</item>
        <item name="android:layout_marginTop">13dip</item>
        <item name="android:layout_marginBottom">8dip</item>
    </style>

    <style name="WorkspaceIcon.Landscape">
        <item name="android:drawablePadding">3dip</item>
        <item name="android:paddingTop">2dip</item>
        <item name="android:layout_marginLeft">10dip</item>
        <item name="android:layout_marginRight">10dip</item>
    </style>

    <style name="SearchButton" parent="@android:style/Widget.Button.Small">
        <item name="android:paddingTop">7dip</item>
        <item name="android:paddingBottom">9dip</item>
        <item name="android:paddingLeft">10dip</item>
        <item name="android:paddingRight">10dip</item>
    </style>

    <style name="HotseatButton">
        <item name="android:paddingLeft">12dip</item>
        <item name="android:paddingRight">12dip</item>
        <item name="android:background">@drawable/hotseat_bg_center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:scaleType">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="HotseatButton.Left">
        <item name="android:layout_marginLeft">4dip</item>
        <item name="android:background">@drawable/hotseat_bg_left</item>
    </style>
    <style name="HotseatButton.Right">
        <item name="android:layout_marginRight">4dip</item>
        <item name="android:background">@drawable/hotseat_bg_right</item>
    </style>


    <!-- Tweaks: launcher settings window (Gingerbread dark theme, own title bar) -->
    <style name="Theme.Settings" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Gingerbread dialogs (GbDialog): transparent window, the popup frames come from the layout -->
    <style name="Theme.GbDialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorPrimary">@color/gb_primary_text_dark</item>
        <item name="android:textColorSecondary">@color/gb_secondary_text_dark</item>
        <item name="android:textColorPrimaryInverse">@color/gb_primary_text_light_disable_only</item>
        <item name="android:editTextBackground">@drawable/gb_edit_text</item>
        <item name="android:editTextColor">@android:color/black</item>
    </style>

    <style name="GbDialogButton">
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">2</item>
        <item name="android:background">@drawable/gb_btn_default</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gb_primary_text_light_nodisable</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
