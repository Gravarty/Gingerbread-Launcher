<?xml version="1.0" encoding="utf-8"?>
<!-- Tweaks: preference.xml of Gingerbread 2.3.7, with the list selector as background -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dip"
    android:gravity="center_vertical"
    android:paddingRight="10dip"
    android:background="@drawable/gb_list_selector_background"
    android:clickable="true">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dip"
        android:layout_marginRight="6dip"
        android:layout_marginTop="6dip"
        android:layout_marginBottom="6dip"
        android:layout_weight="1">

        <TextView android:id="@+id/settings_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="22sp"
            android:textColor="@color/gb_primary_text_dark"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal" />

        <TextView android:id="@+id/settings_item_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/settings_item_title"
            android:layout_alignLeft="@id/settings_item_title"
            android:textSize="14sp"
            android:textColor="@color/gb_secondary_text_dark"
            android:maxLines="4" />

    </RelativeLayout>

    <!-- preference_widget_checkbox.xml -->
    <CheckBox android:id="@+id/settings_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dip"
        android:layout_gravity="center_vertical"
        android:button="@drawable/gb_btn_check"
        android:background="@null"
        android:minWidth="0dip"
        android:minHeight="0dip"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone" />

</LinearLayout>
