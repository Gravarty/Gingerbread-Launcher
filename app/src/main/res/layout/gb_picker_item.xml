<!-- Tweaks: row of the Gingerbread pickers, taken from the framework's resolve_list_item
     (android-2.3.7_r1) without the second text line. Used by PickerDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:minHeight="64dip"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:paddingLeft="10dip"
    android:paddingRight="15dip">

    <ImageView android:id="@+id/picker_icon"
        android:layout_width="48dip"
        android:layout_height="48dip"
        android:scaleType="fitCenter" />

    <TextView android:id="@+id/picker_text"
        android:textAppearance="?android:attr/textAppearanceLargeInverse"
        android:textSize="22sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingLeft="10dip" />
</LinearLayout>
