<?xml version="1.0" encoding="utf-8"?>
<!-- Port: layout-port/miniwidget_weather of Google's "News and Weather" 1.3.01 (the
     weather widget), with widget_loading / widget_retry included -->
<!-- Port: the widget keeps the height of a Gingerbread row (100dp)
     and is centered when a launcher gives it more. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/weather_widget"
        android:background="@drawable/genie_appwidget_dark_bg_selector"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="center_vertical">

        <!-- loading / retry, the same in both layouts -->
        <include layout="@layout/genie_weather_widget_states" />

        <LinearLayout
            android:id="@+id/content"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp">

            <LinearLayout
                android:id="@+id/weather"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:paddingTop="2dp"
                    android:layout_width="75dp"
                    android:layout_height="75dp" />

                <!-- Port: as in genie_weather_widget_wide: the icon on the left, the
                     city/condition/high-low block on the right, the free width on both
                     sides of the temperature. City and condition at most 110dp: in a
                     LinearLayout with weights the block gets measured with the whole width
                     and wouldn't be shortened, the limit leaves room for the temperature. -->
                <LinearLayout
                    android:id="@+id/weather_extra"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1">

                    <!-- FrameLayout: Space isn't allowed in RemoteViews -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/weather_temp"
                        android:textSize="50dp"
                        android:textColor="@android:color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:singleLine="true"
                        android:includeFontPadding="false" />

                    <!-- FrameLayout: Space isn't allowed in RemoteViews -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <!-- marginRight: the visible gap the weather icon has on the left (the
                         75dp icons are transparent for about 11dp at their edges), so the
                         text block sits as far from the right edge as the icon from the left -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="11dp">

                        <TextView
                            android:id="@+id/weather_city"
                            android:maxWidth="110dp"
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/weather_condition"
                            android:maxWidth="110dp"
                            android:textSize="12dp"
                            android:textColor="@android:color/white"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_below="@id/weather_city" />

                        <TextView
                            android:id="@+id/weather_high"
                            android:textSize="20dp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/weather_condition" />

                        <TextView
                            android:id="@+id/weather_low"
                            android:textSize="20dp"
                            android:textColor="#ffbfbfbf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_toRightOf="@id/weather_high"
                            android:layout_below="@id/weather_condition" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_unavailable"
                    android:textSize="10dp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/genie_weather_unavailable"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
