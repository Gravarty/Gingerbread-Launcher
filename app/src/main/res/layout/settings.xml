<?xml version="1.0" encoding="utf-8"?>
<!-- Tweaks: launcher settings window, built like a Gingerbread settings screen
     (screen_title.xml + preference_list_content.xml of 2.3.7) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ff000000"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="25dip"
        android:background="@drawable/gb_activity_title_bar">
        <TextView android:id="@+id/settings_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:fadingEdge="horizontal"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#BB000000"
            android:shadowRadius="2.75" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:foregroundGravity="fill_horizontal|top"
        android:foreground="@drawable/gb_title_bar_shadow">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarStyle="outsideOverlay"
            android:fadingEdge="vertical">
            <LinearLayout android:id="@+id/settings_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
