<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" />

    <application android:label="@string/wallpaper_galaxy">

        <!-- Port: the "Galaxy" live wallpaper from AOSP packages/wallpapers/Basic. -->
        <service
            android:label="@string/wallpaper_galaxy"
            android:name="com.android.wallpaper.galaxy.GalaxyWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/galaxy" />
        </service>

    </application>
</manifest>
