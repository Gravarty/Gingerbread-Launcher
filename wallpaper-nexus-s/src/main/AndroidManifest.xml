<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" />

    <application android:label="@string/wallpaper_nexus_s">

        <!-- Port: the Nexus S variant of it (device/samsung/crespo overlay). -->
        <service
            android:label="@string/wallpaper_nexus_s"
            android:name="com.android.wallpaper.nexus.NexusSWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/nexus_s" />
        </service>

    </application>
</manifest>
