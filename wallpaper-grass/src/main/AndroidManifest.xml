<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" />

    <!-- For the times of sunrise and sunset; granted in the app's settings, else the
         original's fallback times are used -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application android:label="@string/wallpaper_grass">

        <!-- Port: the "Grass" live wallpaper from AOSP packages/wallpapers/Basic. -->
        <service
            android:label="@string/wallpaper_grass"
            android:name="com.android.wallpaper.grass.GrassWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/grass" />
        </service>

    </application>
</manifest>
