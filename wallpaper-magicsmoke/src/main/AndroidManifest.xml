<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" />

    <application android:label="@string/wallpaper_magicsmoke">

        <!-- Port: the "Magic Smoke" live wallpaper from AOSP packages/wallpapers/MagicSmoke. -->
        <service
            android:label="@string/wallpaper_magicsmoke"
            android:name="com.android.magicsmoke.MagicSmoke"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/magicsmoke" />
        </service>

        <activity
            android:name="com.android.magicsmoke.MagicSmokeSelector"
            android:theme="@style/Preview"
            android:exported="true">
        </activity>

    </application>
</manifest>
